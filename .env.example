# Next.js Web App Database (Zero-config SQLite default; supports Postgres/MongoDB)
DATABASE_URL="file:./dev.db"

# Shared HMAC-SHA256 Secret Key for ESP32 Smart Bin Telemetry
IOT_DEVICE_SECRET="sustainx-iot-secret-2024"

# OpenWeatherMap API Key (Optional; defaults to realistic Salt Lake PIN 700091 fallback)
OPENWEATHER_API_KEY=""

# Internal Python FastAPI Micro-dMRV URL
FASTAPI_URL="http://localhost:8000"

# Polygon Amoy Testnet Deployment (Contracts)
DEPLOYER_PRIVATE_KEY=""
POLYGON_AMOY_RPC="https://rpc-amoy.polygon.technology"
